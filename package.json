{
  "name": "da-cli-0-6-6",
  "private": true,
  "version": "0.1.0",
  "description": "da-cli 0.6.6 release site — The Outer Loop",
  "scripts": {
    "build:motion": "node tools/build-outer-loop-lottie.mjs",
    "check:motion": "node tools/build-outer-loop-lottie.mjs .da/out/outer-loop-hero.lottie.json && cmp -s .da/out/outer-loop-hero.lottie.json media/outer-loop-hero.lottie.json",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "check": "npm run lint && npm run check:motion"
  },
  "author": "somarc",
  "license": "Apache License 2.0",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.7",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0"
  }
}
